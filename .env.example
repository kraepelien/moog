# Copy to .env on the machine that runs the app. Never committed: see .gitignore.
#
# With MOOG_OAUTH_CLIENT_ID unset the app runs as a single local user and
# nothing is gated, which is how development and the test suite run.

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). A Web client matches the redirect URI exactly, port and all,
# so every origin you sign in from has to be registered:
#   https://moog.pomello.se/api/auth/google/callback
#   http://localhost:5173/api/auth/google/callback
# The dev server takes the next free port when one is busy, so sign in on 5173
# or register the other ports too.
MOOG_OAUTH_CLIENT_ID=
MOOG_OAUTH_CLIENT_SECRET=

# Any long random string. Changing it signs everybody out.
MOOG_SESSION_SECRET=

# Where the app is reached, used to build the redirect URI. Required wherever the
# app is deployed, because a request's own Host is forgeable.
#
# Set it to the origin you actually browse. On this machine that is the dev
# server, so http://localhost:5173 — NOT the production domain, or signing in
# locally sends you to production.
MOOG_PUBLIC_ORIGIN=

# Comma-separated emails. Anyone may sign in; these may also unpublish and
# delete what others have made.
MOOG_ADMINS=

# What open registration costs, with the defaults shown. Leave them unset
# unless somebody actually meets one.
MOOG_MAX_PATCHES=2000
MOOG_MAX_PATCH_BYTES=65536
MOOG_TRASH_DAYS=30
MOOG_WRITES_PER_MINUTE=120
MOOG_SIGN_INS_PER_MINUTE=10
